#!/usr/bin/env python3
"""Apply the rhdevvps settings manifest, or restore one full config backup.

Only this entrypoint honors its flock. Quiesce OMP and other config writers
before using full-file rollback; OMP's native settings lock is independent.
"""

import argparse
import contextlib
import copy
from datetime import datetime, timezone
import fcntl
import json
import math
import os
from pathlib import Path
import shutil
import sqlite3
import stat
import subprocess
import sys
import tempfile


REVIEWERS = frozenset(("reviewer-openai", "reviewer-claude", "reviewer-grok",
                       "gate-reviewer", "reviewer", "security-reviewer"))
RECORD = "task.agentCompactionThresholdOverrides"
POLICIES = "auth.accountPolicies"
RESERVE_POLICY = "retry.usageReservePolicy"
RESERVE_POLICIES = ("confirm", "auto", "fail-closed")
RULE_FIELDS = frozenset(("provider", "account", "priority", "reservePct", "reclaimAbovePct"))
MANIFEST_RULE_FIELDS = frozenset(("provider", "account", "reservePct"))
SELECTOR_FIELDS = ("email", "accountId", "projectId", "orgId")
SCHEMA = {
    "compaction.thresholdTokens": int,
    "compaction.idleEnabled": bool,
    "compaction.idleThresholdTokens": int,
    "compaction.idleTimeoutSeconds": int,
    "tools.artifactSpillThreshold": int,
    "tools.artifactTailLines": int,
    RECORD: dict,
    "retry.fallbackOn": str,
    "retry.usageAwareFallback": bool,
    RESERVE_POLICY: str,
    "composer.predictions": bool,
    POLICIES: list,
}
# `omp config list` hides a scalar or list parent such as `auth: 5`, and
# `omp config set auth.x` silently replaces it. OMP parses config.yml with
# Bun.YAML; its bundled Bun runtime reports each parent's kind, never values.
PARENTS = sorted({".".join(key.split(".")[:depth]) for key in SCHEMA
                  for depth in range(1, key.count(".") + 1)})
SHAPE_SCRIPT = """
const kind = (v) => v === null ? "null" : Array.isArray(v) ? "array" : typeof v;
const object = (v) => v !== null && typeof v === "object" && !Array.isArray(v);
const data = Bun.YAML.parse(await Bun.stdin.text());
const kinds = {"": kind(data)};
for (const path of JSON.parse(process.env.APPLY_OMP_PARENTS)) {
  kinds[path] = kind(path.split(".").reduce((node, part) => object(node) ? node[part] : undefined, data));
}
console.log(JSON.stringify(kinds));
"""


class SettingsError(Exception):
    pass


def fail(message):
    raise SettingsError(message)


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            fail("Duplicate JSON key")
        result[key] = value
    return result


def invalid_constant(_value):
    fail("Non-finite JSON value")


def parse_json(text, label):
    try:
        return json.loads(text, object_pairs_hook=unique_object,
                          parse_constant=invalid_constant)
    except (ValueError, SettingsError):
        fail(f"Malformed JSON from {label}")


def validate_value(key, value, manifest=False):
    if type(value) is not SCHEMA[key]:
        fail(f"Invalid value type for {key}")
    if manifest and type(value) is int and value <= 0:
        fail(f"Expected a positive integer for {key}")
    if key == RECORD:
        if manifest and set(value) != REVIEWERS:
            fail("Manifest must specify exactly the managed reviewers")
        for reviewer in REVIEWERS & value.keys():
            if type(value[reviewer]) is not int or value[reviewer] <= 0:
                fail("Invalid managed reviewer threshold")
    if manifest and key == "retry.fallbackOn" and value != "usage-limit":
        fail("Unsupported retry.fallbackOn in manifest")
    if key == RESERVE_POLICY and value not in (("auto",) if manifest else RESERVE_POLICIES):
        fail(f"Unsupported {RESERVE_POLICY}")
    if key == POLICIES:
        validate_policies(value, manifest)


def number(value):
    return type(value) in (int, float) and math.isfinite(value)


def validate_rule(rule, global_reserve=0):
    # Mirrors OMP 19.1.1's auth.accountPolicies parser: `omp config set` stores
    # any array, and a bad rule only fails later, at credential selection.
    if type(rule) is not dict or not set(rule) <= RULE_FIELDS:
        fail(f"Invalid {POLICIES} entry")
    provider, account = rule.get("provider"), rule.get("account")
    if type(provider) is not str or not provider or provider.strip() != provider:
        fail(f"Invalid {POLICIES} provider")
    if (type(account) is not dict or not set(account) <= set(SELECTOR_FIELDS)
            or not set(account) - {"orgId"}
            or any(type(v) is not str or not v for v in account.values())):
        fail(f"Invalid {POLICIES} account selector")
    if "priority" in rule and not number(rule["priority"]):
        fail(f"Invalid {POLICIES} priority")
    reserve = rule.get("reservePct", global_reserve)
    if not (number(reserve) and 0 <= reserve <= 100):
        fail(f"Invalid {POLICIES} reservePct")
    # OMP compares reclaimAbovePct with the rule's reserve, or the global
    # retry.usageReservePct when the rule has none.
    if "reclaimAbovePct" in rule and not (number(rule["reclaimAbovePct"])
                                          and reserve < rule["reclaimAbovePct"] <= 100):
        fail(f"Invalid {POLICIES} reclaimAbovePct")


def validate_policies(rules, manifest):
    seen = set()
    for rule in rules:
        validate_rule(rule)
        if not manifest:
            continue
        if set(rule) != MANIFEST_RULE_FIELDS or type(rule["reservePct"]) is not int:
            fail(f"Manifest {POLICIES} entries need exactly provider, account, integer reservePct")
        identity = json.dumps([rule["provider"], rule["account"]], sort_keys=True)
        if identity in seen:
            fail(f"Manifest {POLICIES} repeats an account rule")
        seen.add(identity)
    if manifest and not rules:
        fail(f"Manifest {POLICIES} must not be empty")


def load_manifest():
    path = Path(__file__).resolve().parent.parent / "hosts/rhdevvps/omp-settings.json"
    manifest = parse_json(path.read_text(), "manifest")
    if type(manifest) is not dict or set(manifest) != set(SCHEMA):
        fail("Manifest must contain exactly the managed setting keys")
    for key, value in manifest.items():
        validate_value(key, value, manifest=True)
    return manifest


def read_regular(path, missing_ok=False):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as error:
        if missing_ok and isinstance(error, FileNotFoundError):
            return None
        fail(f"Expected a readable regular file, not a symlink: {path}")
    with os.fdopen(fd, "rb") as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            fail(f"Expected a regular file: {path}")
        return stream.read()


@contextlib.contextmanager
def own_lock(config):
    path = config.parent / ".apply-omp-settings.lock"
    fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600):
            fail("Unsafe entrypoint lock file")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("Settings entrypoint lock is held by another invocation")
        yield
    finally:
        os.close(fd)


class OmpSession:
    """No HOME, XDG, project, overlay, or DB access outside this session.

    Read sessions copy only config.yml, never the potentially large agent DB.
    A write session points PI_CODING_AGENT_DIR at the target explicitly.
    """

    def __init__(self, executable, content=None, target=None):
        self.executable = executable
        self.temp = tempfile.TemporaryDirectory(prefix="apply-omp-settings-")
        self.root = Path(self.temp.name)
        self.profile = target if target is not None else self.root / "agent"
        self.profile.mkdir(exist_ok=True)
        if content is not None:
            profile_config = self.profile / "config.yml"
            profile_config.touch(mode=0o600)
            profile_config.write_bytes(content)
        self.env = dict(os.environ)
        # Named profiles ignore PI_CODING_AGENT_DIR; never inherit a selector
        # that could redirect a preview, write, or readback to another profile.
        for key in ("OMP_PROFILE", "PI_PROFILE", "PI_CONFIG_DIR"):
            self.env.pop(key, None)
        self.env["PI_CODING_AGENT_DIR"] = str(self.profile)
        self.env["PI_CONFIG_FILES"] = ""
        for key, directory in (("HOME", "home"), ("XDG_CONFIG_HOME", "config"),
                               ("XDG_DATA_HOME", "data"), ("XDG_CACHE_HOME", "cache"),
                               ("XDG_STATE_HOME", "state"), ("XDG_RUNTIME_DIR", "runtime")):
            path = self.root / directory
            path.mkdir(mode=0o700)
            self.env[key] = str(path)

    def __enter__(self):
        return self

    def __exit__(self, *_args):
        self.temp.cleanup()

    def command(self, args, label, expect_json=True):
        result = subprocess.run([self.executable, "config", *args], cwd=self.root,
                                env=self.env, capture_output=True, text=True)
        # Do not echo CLI diagnostics: they can contain unowned settings/secrets.
        # A warning may mean OMP fell back after a config parse failure.
        if result.returncode or result.stderr.strip():
            fail(f"OMP {label} failed or emitted diagnostics (exit {result.returncode})")
        if expect_json:
            return parse_json(result.stdout, f"OMP {label}")
        return None

    def selected_list(self):
        data = self.command(["list", "--scope", "global", "--json"], "global list")
        if type(data) is not dict:
            fail("Malformed OMP global list")
        selected = {}
        for key in SCHEMA:
            if key not in data:
                continue
            item = data[key]
            if type(item) is not dict or "value" not in item:
                fail(f"Missing value in OMP global list for {key}")
            validate_value(key, item["value"])
            selected[key] = item["value"]
        return selected

    def readings(self):
        values = {}
        for key in SCHEMA:
            item = self.command(["get", key, "--json"], f"get {key}")
            if type(item) is not dict or item.get("key") != key or "value" not in item:
                fail(f"Missing or malformed OMP reading for {key}")
            validate_value(key, item["value"])
            values[key] = item["value"]
        return values

    def global_reserve(self):
        # Effective retry.usageReservePct (unmanaged): OMP checks a rule's
        # reclaimAbovePct against it when the rule has no reservePct.
        item = self.command(["get", "retry.usageReservePct", "--json"], "get retry.usageReservePct")
        value = item.get("value") if type(item) is dict else None
        if not (number(value) and 0 <= value <= 100):
            fail("Missing or malformed OMP reading for retry.usageReservePct")
        return value

    def check_local_accounts(self):
        # With an auth broker, OMP selects among accounts the local DB lacks.
        item = self.command(["get", "auth.broker.url", "--json"], "get auth.broker.url")
        if os.environ.get("OMP_AUTH_BROKER_URL") or type(item) is not dict or item.get("value"):
            fail("An OMP auth broker is configured; its accounts are not in the local agent database")

    def set_value(self, key, value):
        self.command(["set", key, json.dumps(value, separators=(",", ":"))],
                     f"set {key}", expect_json=False)

    def check_parents(self, content):
        env = dict(self.env, BUN_BE_BUN="1", APPLY_OMP_PARENTS=json.dumps(PARENTS))
        result = subprocess.run([self.executable, "-e", SHAPE_SCRIPT], input=content,
                                cwd=self.root, env=env, capture_output=True)
        if result.returncode or result.stderr.strip():
            fail(f"OMP config shape check failed (exit {result.returncode})")
        kinds = parse_json(result.stdout.decode(), "OMP config shape check")
        if type(kinds) is not dict:
            fail("Malformed OMP config shape check")
        for path in ("", *PARENTS):
            # An absent parent, or an empty document, becomes a mapping
            # without losing data; an explicit `auth: null` is refused too.
            if kinds.get(path) not in (("object", "null", "undefined") if path == ""
                                       else ("object", "undefined")):
                fail(f"{path or 'The config root'} in config.yml is not a mapping;"
                     " omp config set would replace it")


def capture(executable, content):
    with OmpSession(executable, content=content) as session:
        return session.selected_list(), session.readings()


def display_value(key, value):
    if key == RECORD:
        value = {reviewer: threshold for reviewer, threshold in value.items()
                 if reviewer in REVIEWERS}
    if key == POLICIES:
        # Show which selector fields a rule uses, never their values.
        value = [{"provider": rule["provider"], "account": sorted(rule["account"]),
                  **{field: rule[field] for field in ("priority", "reservePct", "reclaimAbovePct")
                     if field in rule}}
                 for rule in value]
    return json.dumps(value, sort_keys=True)


def database_state(database):
    info = os.lstat(database)
    return (info.st_ino, info.st_size, info.st_mtime_ns, os.path.lexists(f"{database}-wal"))


def stored_accounts(profile, providers):
    """Selector fields of each active stored OAuth account, per provider.

    Reads the agent DB read-only and selects only email/accountId/projectId/orgId
    in SQL; token fields never leave SQLite, and errors never echo stored values.
    """
    accounts = {provider: [] for provider in providers}
    data_home = os.environ.get("XDG_DATA_HOME")
    if data_home and os.path.lexists(os.path.join(data_home, "omp")):
        # OMP then keeps the default profile's agent.db under XDG_DATA_HOME.
        fail("OMP data under XDG_DATA_HOME is not supported; the account store is elsewhere")
    database = profile / "agent.db"
    fields = ", ".join(f"json_extract(data, '$.{field}')" for field in SELECTOR_FIELDS)
    marks = ", ".join("?" for _ in providers)
    sql = (f"SELECT id, provider, identity_key, json_type(data), {fields} FROM auth_credentials"
           f" WHERE credential_type = 'oauth' AND disabled_cause IS NULL AND provider IN ({marks})"
           " ORDER BY id DESC")

    def read(query):
        with contextlib.closing(sqlite3.connect(database.as_uri() + query,
                                                uri=True, timeout=10)) as db:
            return db.execute(sql, sorted(providers)).fetchall()

    try:
        if not stat.S_ISREG(os.lstat(database).st_mode):
            fail("Expected a regular agent database")
        with open(database, "rb") as handle:
            wal_mode = handle.read(20)[18:19] == b"\x02"
        # A read-only open of a WAL database creates -wal/-shm sidecars when no
        # connection holds them. Any open OMP connection keeps a -wal file, so
        # without one every committed row is in the main file: read it
        # immutable. If that read fails or the file or its -wal changed
        # meanwhile, read again with locking.
        state = database_state(database)
        rows = None
        if wal_mode and not state[3]:
            with contextlib.suppress(sqlite3.Error):
                rows = read("?immutable=1")
            if database_state(database) != state:
                rows = None
        if rows is None:
            rows = read("?mode=ro")
    except (OSError, sqlite3.Error):
        fail("Cannot read stored OAuth accounts from the agent database")
    seen = set()
    # OMP prunes rows sharing an identity before it matches policies, keeping
    # the newest; it stores that identity in identity_key.
    for row, provider, identity, kind, *values in rows:
        if kind != "object":
            fail("Malformed stored OAuth credential")
        key = (provider, identity.strip() if type(identity) is str and identity.strip() else row)
        if key in seen:
            continue
        seen.add(key)
        accounts[provider].append({field: value for field, value in zip(SELECTOR_FIELDS, values)
                                   if type(value) is str})
    for stored in accounts.values():
        stored.reverse()
    return accounts


def selects(selector, credential):
    # OMP's matcher: every selector field equals the stored credential's field.
    return all(credential.get(field) == value for field, value in selector.items())


def check_unique(rules, accounts):
    # OMP refuses credential selection for a provider when one rule matches
    # several stored accounts or two rules match one. Report indices only.
    for provider, stored in accounts.items():
        owners = {}
        for index, rule in enumerate(rules):
            if rule["provider"] != provider:
                continue
            hits = [n for n, credential in enumerate(stored) if selects(rule["account"], credential)]
            if len(hits) > 1:
                fail(f"{POLICIES}[{index}] matches {len(hits)} stored {provider} accounts")
            if hits and hits[0] in owners:
                fail(f"{POLICIES}[{owners[hits[0]]}] and [{index}] match the same"
                     f" stored {provider} account")
            if hits:
                owners[hits[0]] = index


def merge_policies(current, managed, accounts, global_reserve):
    """Set reservePct on the one rule that selects each manifest account.

    That rule keeps its selector and other fields; every other rule is kept
    as-is. Without such a rule, the manifest rule is appended.
    """
    for rule in current:
        # The live rule as OMP reads it now, before any reservePct is set.
        validate_rule(rule, global_reserve)
    desired = copy.deepcopy(current)
    targets = set()
    for index, rule in enumerate(managed):
        provider, label = rule["provider"], f"Manifest {POLICIES}[{index}]"
        stored = accounts[provider]
        hits = [n for n, credential in enumerate(stored) if selects(rule["account"], credential)]
        if len(hits) != 1:
            fail(f"{label} must match exactly one stored {provider} OAuth account,"
                 f" matches {len(hits)}")
        if (provider, hits[0]) in targets:
            fail(f"{label} selects an account another manifest rule selects")
        targets.add((provider, hits[0]))
        owners = [existing for existing in desired if existing["provider"] == provider
                  and selects(existing["account"], stored[hits[0]])]
        if len(owners) > 1:
            fail(f"{label}: {len(owners)} existing rules select its account;"
                 " resolve them by hand")
        if owners:
            owners[0]["reservePct"] = rule["reservePct"]
        else:
            desired.append(copy.deepcopy(rule))
    for rule in desired:
        validate_rule(rule, global_reserve)
    check_unique(desired, accounts)
    return desired


def show_values(title, selected):
    print(title, flush=True)
    for key in SCHEMA:
        value = display_value(key, selected[key]) if key in selected else "<unset>"
        print(f"  {key}: {value}", flush=True)


def equal(left, right):
    # JSON equality must distinguish true from 1, unlike Python's equality.
    return json.dumps(left, sort_keys=True) == json.dumps(right, sort_keys=True)


def verify(expected_global, expected_readings, actual_global, actual_readings):
    for key in SCHEMA:
        if (key in expected_global) != (key in actual_global):
            fail(f"Global read-back is missing or unexpectedly contains {key}")
        if key in expected_global and not equal(expected_global[key], actual_global[key]):
            fail(f"Global read-back mismatch for {key}")
        if not equal(expected_readings[key], actual_readings[key]):
            fail(f"Effective read-back mismatch for {key}")


def backup_config(config, content):
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    fd, name = tempfile.mkstemp(prefix=f"config.yml.bak-{stamp}-", dir=config.parent)
    with os.fdopen(fd, "wb") as stream:
        stream.write(content)
        stream.flush()
        os.fsync(stream.fileno())
    print(f"Backup: {name}", flush=True)
    return Path(name)


def restore_atomic(config, content):
    fd, name = tempfile.mkstemp(prefix=".config.yml.restore-", dir=config.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, config)
        directory = os.open(config.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def backup_input(argument, config):
    path = Path(os.path.abspath(os.path.expanduser(argument)))
    if (path.parent.resolve() != config.parent
            or not path.name.startswith("config.yml.bak-")
            or path.name == "config.yml.bak-"):
        fail("Rollback requires a backup in the target config.yml.bak-* family")
    return read_regular(path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="show differences without target writes")
    mode.add_argument("--rollback", metavar="BACKUP", help="restore a full target-family backup")
    args = parser.parse_args()
    if args.rollback == "":
        fail("Rollback requires a backup path")
    manifest = None if args.rollback is not None else load_manifest()
    executable = shutil.which("omp")
    if executable is None:
        fail("omp must be available on PATH")
    executable = str(Path(executable).resolve())
    # Legacy rhdevvps OMP profile location. Never invoke a live CLI just to
    # discover this: even a config read may open and mutate the agent database.
    profile = Path(os.environ.get("PI_CODING_AGENT_DIR") or "~/.omp/agent").expanduser().resolve()
    config = profile / "config.yml"
    lock = contextlib.nullcontext() if args.dry_run else own_lock(config)
    with lock:
        original = read_regular(config, missing_ok=args.rollback is not None)
        if args.rollback is not None:
            restored = backup_input(args.rollback, config)
            expected_global, expected_readings = capture(executable, restored)
            try:
                if original is None:
                    print("Before: current config is missing.", flush=True)
                else:
                    before_global, _ = capture(executable, original)
                    show_values("Before (managed global values):", before_global)
            except (SettingsError, OSError, UnicodeError):
                print("Before: current managed values unavailable.", flush=True)
            if read_regular(config, missing_ok=True) != original:
                fail("Config changed while preparing rollback; quiesce other writers")
            if original is not None:
                backup_config(config, original)
            restore_atomic(config, restored)
            after_global, after_readings = capture(executable, read_regular(config))
            verify(expected_global, expected_readings, after_global, after_readings)
            show_values("After (managed global values):", after_global)
            print("Rollback verified.")
            return

        with OmpSession(executable, content=original) as session:
            session.check_parents(original)
            global_reserve = session.global_reserve()
            session.check_local_accounts()
        before_global, _ = capture(executable, original)
        current = before_global.get(POLICIES, [])
        # Every provider with a rule: OMP checks uniqueness for each of them.
        providers = {rule["provider"] for rule in manifest[POLICIES] + current}
        accounts = stored_accounts(profile, providers)

        desired = dict(manifest)
        desired[RECORD] = dict(before_global.get(RECORD, {}))
        desired[RECORD].update(manifest[RECORD])
        desired[POLICIES] = merge_policies(current, manifest[POLICIES], accounts, global_reserve)
        if args.dry_run:
            print("Dry run (managed global differences only):")
            changed = False
            for key in SCHEMA:
                if key not in before_global or not equal(before_global[key], desired[key]):
                    old = display_value(key, before_global[key]) if key in before_global else "<unset>"
                    print(f"  {key}: {old} -> {display_value(key, desired[key])}")
                    changed = True
            if not changed:
                print("  No changes.")
            return

        show_values("Before (managed global values):", before_global)
        if read_regular(config) != original:
            fail("Config changed while preparing apply; quiesce other writers")
        backup_config(config, original)
        with OmpSession(executable, target=profile) as session:
            for key in SCHEMA:
                session.set_value(key, desired[key])
        # Fresh process reads from a fresh profile copy, not a process-local cache.
        after_global, after_readings = capture(executable, read_regular(config))
        verify(desired, desired, after_global, after_readings)
        if stored_accounts(profile, providers) != accounts:
            fail("Stored OAuth accounts changed during apply; quiesce logins, "
                 "re-run --dry-run, then apply or roll back to the printed backup")
        show_values("After (managed global values):", after_global)
        print("Apply verified.")


if __name__ == "__main__":
    try:
        main()
    except (SettingsError, OSError, UnicodeError) as error:
        print(f"apply-omp-settings: {error}", file=sys.stderr)
        sys.exit(1)
